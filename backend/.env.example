# Copy this file to .env and fill in your MongoDB Atlas connection string.
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=student_portal

# Password for the "admin" login (manages all student records)
ADMIN_PASSWORD=change-me
# Long random string used to sign login tokens, e.g. from:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=
